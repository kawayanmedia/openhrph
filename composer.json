{
    "name": "kawayanmedia/openhrph",
    "type": "project",
    "description": "OpenHR PH Open Source Payroll System",
    "keywords": [
        "framework",
        "laravel",
        "PHP",
        "payroll",
        "openhrph",
        "opensource",
        "hris",
        "open-source",
        "open-source-software"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.402",
        "bugsnag/bugsnag-laravel": "^2.31",
        "flowframe/laravel-trend": "^0.5.0",
        "laracraft-tech/laravel-date-scopes": "^2.5",
        "laravel/ai": "^1.3",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.22",
        "laravel/pennant": "^1.26",
        "laravel/reverb": "^1.12",
        "laravel/telescope": "^5.26",
        "laravel/tinker": "^3.0",
        "laravel/vapor-cli": "^1.70",
        "laravel/vapor-core": "^2.47",
        "livewire/livewire": "^3.8",
        "livewire/volt": "^1.11",
        "lorisleiva/laravel-actions": "^2.13",
        "maatwebsite/excel": "^4.0",
        "phpoffice/phpword": "^1.4.0",
        "predis/predis": "^2.4",
        "rats/zkteco": "^002.0",
        "setasign/fpdf": "1.8.*",
        "setasign/fpdi": "^2.6",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-query-builder": "^6.4",
        "spatie/laravel-searchable": "^1.13.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "doctrine/dbal": "^4.5",
        "fakerphp/faker": "^1.24",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "12.5.33",
        "spatie/laravel-cronless-schedule": "^1.3",
        "spatie/laravel-ignition": "^2.12",
        "spatie/laravel-web-tinker": "^1.12",
        "tightenco/duster": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./kawayanmedia/attendance"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php",
            "app/cache_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan cache:clear",
            "@php artisan view:clear"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "format": [
            "vendor/bin/php-cs-fixer fix"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
