#!/usr/bin/env bash
set -euo pipefail

APP_DIR=/var/www/hris
ENV_FILE="$APP_DIR/.env"
CONF_FILE=/etc/hris/bootstrap.conf
STAMP="$(date +%Y%m%d%H%M%S)"
TMP_DUMP="$(mktemp --suffix=.sql.gz)"

trap 'rm -f "$TMP_DUMP"' EXIT

if [ ! -f "$ENV_FILE" ]; then
    echo "No $ENV_FILE; nothing to back up."
    exit 0
fi

# shellcheck source=/dev/null
. "$CONF_FILE"

if [ -z "${HRIS_STORAGE_ACCOUNT:-}" ] || [ -z "${HRIS_STORAGE_CONTAINER:-}" ]; then
    echo "Azure storage settings are not configured; skipping backup."
    exit 0
fi

read_env() {
    local key="$1"
    grep -E "^${key}=" "$ENV_FILE" | head -n 1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//'
}

DB_HOST="$(read_env DB_HOST)"
DB_PORT="$(read_env DB_PORT)"
DB_DATABASE="$(read_env DB_DATABASE)"
DB_USERNAME="$(read_env DB_USERNAME)"
DB_PASSWORD="$(read_env DB_PASSWORD)"
export MYSQL_PWD="$DB_PASSWORD"

az login --identity --output none

echo "Dumping the database"
mysqldump \
    --host="$DB_HOST" \
    --port="${DB_PORT:-3306}" \
    --user="$DB_USERNAME" \
    --single-transaction \
    --quick \
    --routines \
    --triggers \
    "$DB_DATABASE" \
    | gzip > "$TMP_DUMP"

unset MYSQL_PWD

az storage blob upload \
    --account-name "$HRIS_STORAGE_ACCOUNT" \
    --container-name "$HRIS_STORAGE_CONTAINER" \
    --name "database/hris-$STAMP.sql.gz" \
    --file "$TMP_DUMP" \
    --auth-mode login \
    --overwrite

echo "Uploading uploaded files to $HRIS_STORAGE_CONTAINER/storage/public"
az storage blob upload-batch \
    --account-name "$HRIS_STORAGE_ACCOUNT" \
    --destination "$HRIS_STORAGE_CONTAINER" \
    --destination-path "storage/public" \
    --source "$APP_DIR/storage/app/public" \
    --auth-mode login \
    --overwrite
