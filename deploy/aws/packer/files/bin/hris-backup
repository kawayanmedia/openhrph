#!/usr/bin/env bash
set -euo pipefail

APP_DIR=/var/www/hris
ENV_FILE="$APP_DIR/.env"

if [ ! -f "$ENV_FILE" ]; then
    echo "No $ENV_FILE; nothing to back up."
    exit 0
fi

read_env() {
    local key="$1"
    grep -E "^${key}=" "$ENV_FILE" | head -n 1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//'
}

BUCKET="$(read_env AWS_BUCKET)"
REGION="$(read_env AWS_DEFAULT_REGION)"

if [ -z "$BUCKET" ]; then
    echo "AWS_BUCKET is not configured; skipping storage backup."
    exit 0
fi

echo "Syncing uploaded files to s3://$BUCKET/storage/public"
aws s3 sync "$APP_DIR/storage/app/public" "s3://$BUCKET/storage/public" \
    --region "${REGION:-ap-southeast-1}" \
    --delete \
    --only-show-errors
