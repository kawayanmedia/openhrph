#!/usr/bin/env bash
set -euo pipefail

APP_DIR=/var/www/hris
REF="${1:-main}"
PHP_VERSION="$(ls /etc/php | sort -V | tail -n 1)"

if [ ! -d "$APP_DIR/.git" ]; then
    echo "No Git checkout at $APP_DIR." >&2
    exit 1
fi

if [ ! -f "$APP_DIR/.env" ]; then
    echo "No .env at $APP_DIR. Run the bootstrap first." >&2
    exit 1
fi

run_as_app() {
    runuser -u www-data -- env HOME=/var/www bash -lc "cd '$APP_DIR' && $*"
}

echo "Fetching $REF"
run_as_app "git fetch --all --tags"
run_as_app "git checkout '$REF'"

if run_as_app "git symbolic-ref -q HEAD >/dev/null"; then
    run_as_app "git pull --ff-only origin '$REF'"
fi

echo "Installing PHP dependencies"
run_as_app "composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader"

echo "Building front-end assets"
run_as_app "npm ci --no-audit --no-fund"
run_as_app "npm run build"

echo "Building the payroll engine"
run_as_app "make -C payroll-engine build"

echo "Running migrations"
run_as_app "php artisan migrate --force"

echo "Importing statutory tables and 2026 wage orders"
run_as_app "php artisan payroll:statutory:import"
run_as_app "php artisan payroll:wage-orders:import"

if ! run_as_app "php artisan payroll:holidays:import"; then
    echo "Holiday import skipped; run payroll:holidays:import after the first company exists."
fi

echo "Refreshing caches"
run_as_app "php artisan config:cache"
run_as_app "php artisan event:cache"
run_as_app "php artisan view:cache"

chown -R www-data:www-data "$APP_DIR/storage" "$APP_DIR/bootstrap/cache"
chmod -R ug+rwX "$APP_DIR/storage" "$APP_DIR/bootstrap/cache"

echo "Restarting services"
systemctl restart "php${PHP_VERSION}-fpm" nginx hris-queue
systemctl start hris-scheduler.timer hris-backup.timer

echo "Deploy complete. Check /up before routing traffic."
