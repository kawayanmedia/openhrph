aws_region  = "ap-southeast-1"
project     = "hris"
environment = "production"
app_ref     = "main"

instance_type    = "t3.medium"
root_volume_size = 40

# Leave key_name empty to use Session Manager only.
key_name          = ""
ssh_allowed_cidrs = []
# ssh_allowed_cidrs = ["203.0.113.10/32"]

vpc_cidr               = "10.42.0.0/16"
public_subnet_cidrs    = ["10.42.0.0/24", "10.42.1.0/24"]
database_subnet_cidrs  = ["10.42.10.0/24", "10.42.11.0/24"]

db_instance_class       = "db.t3.small"
db_allocated_storage    = 50
db_max_allocated_storage = 200
db_name                 = "hris"
db_username             = "hris"
db_backup_retention_days = 7
db_multi_az             = false

deletion_protection = true
skip_final_snapshot = false
s3_force_destroy    = false

# Set enable_alb = true for HTTPS and a stable DNS name.
enable_alb            = false
domain_name           = ""
route53_zone_id       = ""
acm_certificate_arn   = ""

# Leave empty to derive the URL from the ALB, domain, or Elastic IP.
app_url = ""

tags = {
  Owner = "platform"
}
