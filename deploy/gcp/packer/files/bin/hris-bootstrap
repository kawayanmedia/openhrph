#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/hris-bootstrap.log) 2>&1

APP_DIR=/var/www/hris
ENV_FILE="$APP_DIR/.env"
CONF_FILE=/etc/hris/bootstrap.conf
TMP_ENV="$(mktemp)"

trap 'rm -f "$TMP_ENV"' EXIT

log() {
    printf '[hris-bootstrap] %s\n' "$*"
}

if [ ! -f "$CONF_FILE" ]; then
    log "missing $CONF_FILE"
    exit 1
fi

# shellcheck source=/dev/null
. "$CONF_FILE"

: "${HRIS_PROJECT:?HRIS_PROJECT is required}"
: "${HRIS_ENV_SECRET:?HRIS_ENV_SECRET is required}"

log "starting at $(date -Is)"

for _ in $(seq 1 30); do
    if gcloud secrets versions access latest \
        --secret="$HRIS_ENV_SECRET" \
        --project="$HRIS_PROJECT" > "$TMP_ENV" 2>/dev/null && [ -s "$TMP_ENV" ]; then
        break
    fi
    log "waiting for Secret Manager secret $HRIS_ENV_SECRET"
    sleep 10
done

if [ ! -s "$TMP_ENV" ]; then
    log "could not read $HRIS_ENV_SECRET from Secret Manager"
    exit 1
fi

install -m 0640 -o www-data -g www-data "$TMP_ENV" "$ENV_FILE"
log "wrote $ENV_FILE from Secret Manager"

read_env() {
    local key="$1"
    grep -E "^${key}=" "$ENV_FILE" | head -n 1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//'
}

DB_DATABASE="$(read_env DB_DATABASE)"
DB_USERNAME="$(read_env DB_USERNAME)"
DB_PASSWORD="$(read_env DB_PASSWORD)"
APP_URL="$(read_env APP_URL)"
PORTAL_URL="$(read_env APP_PORTAL_URL)"
ACME_EMAIL="$(read_env HRIS_ACME_EMAIL)"
PHP_VERSION="$(find /etc/php -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -V | tail -n 1)"

if [ -z "$DB_DATABASE" ] || [ -z "$DB_USERNAME" ] || [ -z "$DB_PASSWORD" ]; then
    log "database settings are missing from $ENV_FILE"
    exit 1
fi

if ! printf '%s' "$DB_DATABASE" | grep -qE '^[A-Za-z0-9_]+$' \
    || ! printf '%s' "$DB_USERNAME" | grep -qE '^[A-Za-z0-9_]+$'; then
    log "DB_DATABASE and DB_USERNAME must contain only letters, numbers, and underscores"
    exit 1
fi

systemctl start mysql

log "waiting for MySQL"
db_ready=0
for _ in $(seq 1 60); do
    if mysqladmin --protocol=socket -uroot ping --silent >/dev/null 2>&1; then
        db_ready=1
        break
    fi
    sleep 5
done

if [ "$db_ready" -ne 1 ]; then
    log "MySQL did not become ready"
    exit 1
fi

log "ensuring the database and application user exist"
mysql --protocol=socket -uroot <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_DATABASE}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_USERNAME}'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER '${DB_USERNAME}'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON \`${DB_DATABASE}\`.* TO '${DB_USERNAME}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL

export MYSQL_PWD="$DB_PASSWORD"

unset MYSQL_PWD

log "running migrations"
migrated=0
for _ in $(seq 1 30); do
    if runuser -u www-data -- php "$APP_DIR/artisan" migrate --force; then
        migrated=1
        break
    fi
    sleep 10
done

if [ "$migrated" -ne 1 ]; then
    log "migrations did not complete"
    exit 1
fi

log "importing statutory tables"
runuser -u www-data -- php "$APP_DIR/artisan" payroll:statutory:import

log "importing the 2026 wage orders"
runuser -u www-data -- php "$APP_DIR/artisan" payroll:wage-orders:import

log "importing the 2026 holiday calendar"
if ! runuser -u www-data -- php "$APP_DIR/artisan" payroll:holidays:import; then
    log "holiday import skipped; run payroll:holidays:import after creating the first company"
fi

log "warming caches"
runuser -u www-data -- php "$APP_DIR/artisan" config:cache
runuser -u www-data -- php "$APP_DIR/artisan" event:cache
runuser -u www-data -- php "$APP_DIR/artisan" view:cache

if [ ! -L "$APP_DIR/public/storage" ]; then
    runuser -u www-data -- php "$APP_DIR/artisan" storage:link || true
fi

chown -R www-data:www-data "$APP_DIR/storage" "$APP_DIR/bootstrap/cache" "$ENV_FILE"
chmod 0640 "$ENV_FILE"

scheme="${APP_URL%%://*}"
site="${APP_URL#*://}"
site="${site%%/*}"

portal_site="${PORTAL_URL#*://}"
portal_site="${portal_site%%/*}"

if [ "$scheme" = "https" ] && [ -n "$site" ]; then
    {
        if [ -n "$ACME_EMAIL" ]; then
            printf '{\n    email %s\n}\n\n' "$ACME_EMAIL"
        fi
        printf '%s {\n    encode zstd gzip\n    reverse_proxy 127.0.0.1:8080\n}\n' "$site"

        if [ -n "$portal_site" ] && [ "$portal_site" != "$site" ]; then
            printf '\n%s {\n    encode zstd gzip\n    reverse_proxy 127.0.0.1:8080\n}\n' "$portal_site"
        fi
    } > /etc/caddy/Caddyfile
else
    cat > /etc/caddy/Caddyfile <<'CADDY'
:80 {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}
CADDY
fi

caddy validate --config /etc/caddy/Caddyfile
systemctl reload caddy 2>/dev/null || systemctl restart caddy

log "starting services"
systemctl restart "php${PHP_VERSION}-fpm" nginx hris-queue
systemctl start hris-scheduler.timer hris-backup.timer

for _ in $(seq 1 30); do
    if curl -fsS http://127.0.0.1:8080/up >/dev/null 2>&1; then
        log "health check passed"
        exit 0
    fi
    sleep 5
done

log "health check failed; inspect nginx, php-fpm, and storage/logs/laravel.log"
exit 1
