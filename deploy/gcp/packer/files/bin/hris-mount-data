#!/usr/bin/env bash
set -euo pipefail

CONF_FILE=/etc/hris/bootstrap.conf
MOUNT_POINT=/var/lib/mysql
WAIT_SECONDS="${HRIS_DISK_WAIT_SECONDS:-600}"

log() {
    printf '[hris-mount-data] %s\n' "$*"
}

for _ in $(seq 1 "$WAIT_SECONDS"); do
    if [ -f "$CONF_FILE" ]; then
        break
    fi
    sleep 1
done

if [ ! -f "$CONF_FILE" ]; then
    log "missing $CONF_FILE"
    exit 1
fi

# shellcheck source=/dev/null
. "$CONF_FILE"

if [ -z "${HRIS_DATA_DISK:-}" ]; then
    log "HRIS_DATA_DISK is empty; continuing with the root disk"
    exit 0
fi

if mountpoint -q "$MOUNT_POINT"; then
    log "$MOUNT_POINT is already mounted"
    exit 0
fi

log "waiting for $HRIS_DATA_DISK"
for _ in $(seq 1 "$WAIT_SECONDS"); do
    if [ -b "$HRIS_DATA_DISK" ]; then
        break
    fi
    sleep 1
done

if [ ! -b "$HRIS_DATA_DISK" ]; then
    log "data disk $HRIS_DATA_DISK did not appear"
    exit 1
fi

fresh=0
if ! blkid "$HRIS_DATA_DISK" >/dev/null 2>&1; then
    log "formatting $HRIS_DATA_DISK"
    mkfs.ext4 -m 0 -F "$HRIS_DATA_DISK"
    fresh=1
fi

# The image contains an initialised MySQL system schema. Keep a copy so a new
# or empty data disk can be seeded with it.
backup_dir=""
if [ "$fresh" -eq 1 ] || [ ! -d "$MOUNT_POINT/mysql" ]; then
    backup_dir="$(mktemp -d)"
    cp -a "$MOUNT_POINT/." "$backup_dir"/
fi

mkdir -p "$MOUNT_POINT"
mount "$HRIS_DATA_DISK" "$MOUNT_POINT"

if [ ! -d "$MOUNT_POINT/mysql" ] && [ -n "$backup_dir" ]; then
    log "seeding the data disk with the image MySQL schema"
    cp -a "$backup_dir/." "$MOUNT_POINT"/
    rm -f "$MOUNT_POINT/auto.cnf"
fi

if [ -n "$backup_dir" ]; then
    rm -rf "$backup_dir"
fi

chown mysql:mysql "$MOUNT_POINT"

uuid="$(blkid -s UUID -o value "$HRIS_DATA_DISK")"
if ! grep -q "UUID=$uuid" /etc/fstab; then
    printf 'UUID=%s %s ext4 defaults,nofail 0 2\n' "$uuid" "$MOUNT_POINT" >> /etc/fstab
fi

log "$MOUNT_POINT mounted from $HRIS_DATA_DISK"
