APP_NAME=HRIS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

APP_URL=http://localhost:8080
APP_PORTAL_URL=http://portal.localhost:8080
APP_PORTAL_SUBDOMAIN=portal.localhost
APP_COPYRIGHT="HRIS Payroll System"
APP_COPYRIGHT_YEAR_FROM="2007"

FILAMENT_NAME=HRIS
FILAMENT_PATH=admin
FILAMENT_URL=http://localhost:8080/admin
FILAMENT_FILESYSTEM_DISK=local
NOVA_PATH=/app
NOVA_LICENSE_KEY=

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=change-me-before-deploying
DB_ROOT_PASSWORD=change-root-before-deploying
DB_WAIT_SECONDS=180

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_QUEUE=hris
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="HRIS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_PORT=8080

BUGSNAG_API_KEY=

PAYROLL_ENGINE_DRIVER=go
PAYROLL_ENGINE_BINARY=/var/www/html/bin/payroll-engine
PAYROLL_ENGINE_TIMEOUT=600
PAYROLL_ENGINE_INLINE_THRESHOLD=50

APP_EMPLOYEE_FREE_LIMIT=10
TENANCY_STRICT=true
TRUSTED_PROXIES=*

HRIS_WARM_CACHE=1
HRIS_RUN_DB_INIT=0

# Docker Compose settings
APP_IMAGE=hris:local
APP_VERSION=dev
HTTP_PORT=8080
REVERB_HOST_PORT=8081
HRIS_DOMAIN=
