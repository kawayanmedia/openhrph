APP_NAME="OpenHR PH"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# Debugbar can make Filament tables slow on large data sets.
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ADMIN_PATH=app

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

APP_URL=http://localhost:8000
APP_PORTAL_URL=http://portal.localhost:8000
# .localhost hostnames resolve to loopback in modern browsers.
APP_PORTAL_SUBDOMAIN=portal.localhost
APP_COPYRIGHT="HRIS Payroll System"
APP_COPYRIGHT_YEAR_FROM="2007"

FILAMENT_NAME=HRIS
FILAMENT_PATH=admin
FILAMENT_URL="${APP_URL}/admin"
FILAMENT_FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The full application schema lives in database/schema/hris-schema.sql.
# Automated tests use in-memory SQLite; the app itself expects MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_QUEUE=hris
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SQS_PREFIX=
SQS_QUEUE=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# How many employees for a free account
APP_EMPLOYEE_FREE_LIMIT=10

BUGSNAG_API_KEY=

OCTANE_SERVER=roadrunner

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

DEBUGBAR_EDITOR=vscode
IGNITION_EDITOR=vscode
TENANCY_STRICT=true
# TENANCY_PLATFORM_ADMINS=owner@example.com,cto@example.com
# Company used for unauthenticated public pages (job board).
# TENANCY_PUBLIC_COMPANY_ID=1

ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_URL=
OPENROUTER_API_KEY=
JINA_API_KEY=
TYPESAFE_API_KEY=
VOYAGEAI_API_KEY=
XAI_API_KEY=

# HR assistant (laravel/ai). Blank provider/model fall back to config/ai.php.
ASSISTANT_PROVIDER=
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT=120
ASSISTANT_UNDER_HOURS=80
ASSISTANT_PROMPTS_PER_MINUTE=20