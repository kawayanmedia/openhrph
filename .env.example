# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="OpenHR PH"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# Comma separated keys kept during a key rotation so old payloads still decrypt.
APP_PREVIOUS_KEYS=
# Debugbar can make Filament tables slow on large data sets.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Set to true for the government payroll variant (plantilla, salary grades).
IS_GOVERNMENT=false

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# How many employees a free account may create.
APP_EMPLOYEE_FREE_LIMIT=10

APP_COPYRIGHT="HRIS Payroll System"
APP_COPYRIGHT_YEAR_FROM="2007"

# Portal (employee self-service) host.
APP_PORTAL_URL=http://portal.localhost:8000
# .localhost hostnames resolve to loopback in modern browsers.
APP_PORTAL_SUBDOMAIN=portal.localhost

# Reverse proxies allowed to send X-Forwarded-* headers (bootstrap/app.php).
TRUSTED_PROXIES=127.0.0.1

# Assets for the static 503 maintenance page.
SAHOD_APP_SITE=https://sahodapp.com

# ------------------------------------------------------------------
# Admin panel and Nova
# ------------------------------------------------------------------
ADMIN_PATH=app
# Emergency escape hatch that grants every user admin access. Leave false.
ADMIN_ALLOW_ALL=false
# Comma separated admin menu keys to hide for this installation.
HIDDEN_MENU=

# ------------------------------------------------------------------
# Public demo
# ------------------------------------------------------------------
# Enable visitor sign-up with email verification. Only for the hosted demo.
DEMO_MODE=false
DEMO_URL=https://openhrph.laravel.cloud
# Minutes an email verification link stays valid.
AUTH_VERIFICATION_EXPIRE=60
DEMO_REGISTRATIONS_PER_HOUR=5

FILAMENT_NAME=HRIS
FILAMENT_PATH=admin
FILAMENT_URL="${APP_URL}/admin"
FILAMENT_FILESYSTEM_DISK=local

NOVA_APP_NAME="${APP_NAME}"
NOVA_PATH=/manager
NOVA_DOMAIN_NAME=null
NOVA_GUARD=null
NOVA_LICENSE_KEY=
NOVA_PASSWORDS=null
NOVA_BRAND_COLORS="24, 182, 155"
NOVA_BRAND_LOGO_PATH=/../public/default-logo.svg
NOVA_STORAGE_DISK=public

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------
AUTH_GUARD=web
AUTH_MODEL='App\Models\User'
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="Laravel Log"
LOG_SLACK_EMOJI=":boom:"
LOG_PAPERTRAIL_HANDLER=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Automated tests use in-memory SQLite; the app itself expects MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=root
DB_PASSWORD=
# Full connection URL; overrides the individual settings above when set.
# DB_URL=mysql://user:pass@127.0.0.1:3306/hris
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
MYSQL_ATTR_SSL_CA=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

# Database-backed cache, queue and session tables.
# DB_CACHE_CONNECTION=
# DB_CACHE_LOCK_CONNECTION=
DB_CACHE_TABLE=cache
# DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# ------------------------------------------------------------------
# Session
# ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
# SESSION_CONNECTION=
SESSION_TABLE=sessions
# SESSION_STORE=
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# ------------------------------------------------------------------
# Cache, Redis and queues
# ------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=

DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
# REDIS_PREFIX=
# REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=hris
REDIS_QUEUE_RETRY_AFTER=90

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90

# SQS_PREFIX=
# SQS_QUEUE=
# SQS_SUFFIX=

# ------------------------------------------------------------------
# Broadcasting (Reverb, Pusher, Ably)
# ------------------------------------------------------------------
BROADCAST_CONNECTION=log

REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_APP_PING_INTERVAL=60
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_MAX_REQUEST_SIZE=10000
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

ABLY_KEY=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------
# Mail and notifications
# ------------------------------------------------------------------
MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# ------------------------------------------------------------------
# Filesystems, AWS and media
# ------------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_DISK=public
MEDIA_PREFIX=
IMAGE_DRIVER=gd
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
QUEUE_CONVERSIONS_BY_DEFAULT=true
ENABLE_MEDIA_LIBRARY_VAPOR_UPLOADS=false

# ------------------------------------------------------------------
# Payroll engine
# ------------------------------------------------------------------
# `go` uses bin/payroll-engine; `php` is the slower parity-locked fallback.
PAYROLL_ENGINE_DRIVER=go
# PAYROLL_ENGINE_BINARY=bin/payroll-engine
PAYROLL_ENGINE_TIMEOUT=600
# Explicit MySQL DSN. When empty the default database connection is used.
# PAYROLL_ENGINE_DSN=mysql://user:pass@127.0.0.1:3306/hris
# Payrolls up to this employee count run inline; larger ones are queued.
PAYROLL_ENGINE_INLINE_THRESHOLD=50

# Default country used until `php artisan openhr:install` runs. Add new
# jurisdictions to config/payroll.php before selecting them.
PAYROLL_COUNTRY=PH

# Used by the Docker and golden-image bootstrap scripts to configure a fresh
# installation and seed its sector catalogues. Government or Private; leave
# OPENHR_SECTOR empty to seed the defaults and skip the installer.
# OPENHR_SECTOR=Private
# OPENHR_COUNTRY=PH

# ------------------------------------------------------------------
# Payroll accounting
# ------------------------------------------------------------------
# Account codes written when a processed payroll is approved. Change these to
# match the company's chart of accounts.
PAYROLL_ACCOUNT_SALARIES=5100
PAYROLL_ACCOUNT_EMPLOYER_CONTRIB=5110
PAYROLL_ACCOUNT_TAX_PAYABLE=2100
PAYROLL_ACCOUNT_SSS_PAYABLE=2110
PAYROLL_ACCOUNT_PHILHEALTH_PAYABLE=2120
PAYROLL_ACCOUNT_PAGIBIG_PAYABLE=2130
PAYROLL_ACCOUNT_OTHER_DEDUCTIONS=2140
PAYROLL_ACCOUNT_NET_PAY_PAYABLE=2200

# Password for the company the browser tests create and purge.
E2E_PASSWORD="E2ePassword!2345"

# ------------------------------------------------------------------
# AI providers (laravel/ai)
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_URL=https://api.anthropic.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-6-sol
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2.5-flare
AZURE_OPENAI_STORE=true
AWS_BEDROCK_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_USE_DEFAULT_CREDENTIALS=true
AWS_BEDROCK_ASSUME_ROLE_ARN=
AWS_BEDROCK_ASSUME_ROLE_SESSION_NAME=
AWS_BEDROCK_ASSUME_ROLE_DURATION_SECONDS=
AWS_BEDROCK_ASSUME_ROLE_EXTERNAL_ID=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/
GROQ_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=true
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
VOYAGEAI_API_KEY=
XAI_API_KEY=

# HR assistant (laravel/ai). Blank provider/model fall back to config/ai.php.
ASSISTANT_PROVIDER=
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT=120
ASSISTANT_UNDER_HOURS=80
ASSISTANT_PROMPTS_PER_MINUTE=20

# ------------------------------------------------------------------
# Multi-tenancy
# ------------------------------------------------------------------
# Throw instead of returning no rows when a tenant is not resolved.
TENANCY_STRICT=true
# Comma separated e-mail addresses allowed to manage companies themselves.
# TENANCY_PLATFORM_ADMINS=owner@example.com,cto@example.com
# Company used for unauthenticated public pages (job board).
# TENANCY_PUBLIC_COMPANY_ID=1

# ------------------------------------------------------------------
# Runtime, error tracking and developer tooling
# ------------------------------------------------------------------
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false

PENNANT_STORE=database

FLARE_KEY=
BUGSNAG_API_KEY=

TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope
TELESCOPE_DRIVER=database
# TELESCOPE_DOMAIN=
TELESCOPE_RESPONSE_SIZE_LIMIT=64
TELESCOPE_DUMP_WATCHER_ALWAYS=false

DEBUGBAR_ENABLED=
DEBUGBAR_EDITOR=vscode
DEBUGBAR_THEME=auto
DEBUGBAR_STORAGE_ENABLED=true
DEBUGBAR_STORAGE_DRIVER=file
# DEBUGBAR_STORAGE_PATH=
# DEBUGBAR_STORAGE_CONNECTION=
# DEBUGBAR_OPEN_STORAGE=
DEBUGBAR_FORCE_ALLOW_ENABLE=false
DEBUGBAR_INJECT=true
DEBUGBAR_ROUTE_PREFIX=_debugbar
# DEBUGBAR_ROUTE_DOMAIN=
# DEBUGBAR_REMOTE_SITES_PATH=
# DEBUGBAR_LOCAL_SITES_PATH=

IGNITION_EDITOR=vscode
IGNITION_THEME=auto
IGNITION_SHARING_ENABLED=true
# IGNITION_ENABLE_RUNNABLE_SOLUTIONS=
# IGNITION_REMOTE_SITES_PATH=
# IGNITION_LOCAL_SITES_PATH=
# IGNITION_OPEN_AI_KEY=
REGISTER_IGNITION_COMMANDS=false

PSYSH_CONFIG=

PAYROLL_ENGINE_DRIVER=php

# -----------------------------------------------------------------------------
# NativePHP desktop build
# -----------------------------------------------------------------------------
# The desktop build bundles this .env file into the application, so secrets in
# this file are readable by anyone who has the app. NativePHP strips the keys in
# config/nativephp.php (`cleanup_env_keys`) when it bundles; add anything else
# sensitive there too.
#
# Build the desktop app with `php artisan native:build`, or run it in a native
# window with `php artisan native:run`. See docs/deployment/desktop.md.
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_ID=com.kawayanmedia.openhrph
NATIVEPHP_APP_AUTHOR="Kawayan Media"
NATIVEPHP_APP_WEBSITE=https://github.com/kawayanmedia/openhrph
NATIVEPHP_UPDATER_ENABLED=true
NATIVEPHP_UPDATER_PROVIDER=github
GITHUB_OWNER=kawayanmedia
GITHUB_REPO=openhrph

# Pulse is not installed; Debugbar collectors and Telescope watchers keep the
# defaults declared in config/debugbar.php and config/telescope.php.
